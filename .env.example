# ---------------------------------------------------------------------------
# FEMZYK ENTERPRISES — environment template
# Copy this file to `.env.local` (never commit `.env.local`) and fill in values.
# ---------------------------------------------------------------------------

# Web3Forms access key — the only thing the contact form needs to deliver email.
# 1) Create a free form at https://web3forms.com
# 2) Use femzykenterprisesltd@gmail.com as the "Send to" recipient
# 3) Paste the generated key here (it looks like: 1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d)
#
# NOTE: the NEXT_PUBLIC_ prefix is required by Web3Forms (the browser posts the
# form directly to their API), which means this key is visible in the client
# bundle. That is expected for Web3Forms — it can only send email from your own
# form. If it is ever abused, regenerate it in the Web3Forms dashboard.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# Canonical absolute origin of the deployed site. Used for <link rel="canonical">,
# Open Graph URLs and JSON-LD structured data. Set this to your real production
# domain (e.g. https://femzyk.com) — otherwise it falls back to localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
