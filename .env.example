# Supabase/Vercel integration-managed pair (preferred when both are present).
# Secret key is server-only; never use a NEXT_PUBLIC_ prefix for it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy integration anon key fallback only when publishable key is absent.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Existing manually configured pair (fallback for environments without integration variables).
SUPABASE_URL=https://enhvqlqsuulfjyvmqxxv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Server only: Brevo transactional API key (xkeysib-...), not an SMTP key.
BREVO_API_KEY=
# Server only: a sender address verified in Brevo for transactional email.
BREVO_SENDER_EMAIL=
# Optional. Defaults to the primary business inbox in lib/site.ts.
# ENQUIRY_TO_EMAIL=
NEXT_PUBLIC_SITE_URL=
