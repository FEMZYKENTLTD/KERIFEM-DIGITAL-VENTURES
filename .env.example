# Supabase/Vercel integration-managed pair (preferred when both are present).
# Secret key is server-only; never use a NEXT_PUBLIC_ prefix for it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy integration anon key fallback only when publishable key is absent.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Existing manually configured pair (fallback for environments without integration variables).
SUPABASE_URL=https://enhvqlqsuulfjyvmqxxv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Server only: Brevo transactional API key (xkeysib-...), not an SMTP key.
BREVO_API_KEY=
# Server only: a sender address verified in Brevo for transactional email.
BREVO_SENDER_EMAIL=
# Optional. Defaults to the primary business inbox in lib/site.ts.
# ENQUIRY_TO_EMAIL=
NEXT_PUBLIC_SITE_URL=
# Optional server-only AI service-matching provider. Do not use NEXT_PUBLIC_ prefixes.
# OPENAI_API_KEY=
# GROWTHOS_OPENAI_MODEL=gpt-4o-mini
# Hunter Discover only. Server-only key; never use NEXT_PUBLIC_ or commit a key.
# Verify your account plan, terms and the reviewed database limiter before enabling.
# HUNTER_API_KEY=
# HUNTER_FREE_DISCOVERY_ENABLED=false
# Gmail OAuth for GrowthOS (separate from Arena Gmail). Server-side only.
# Register the exact HTTPS callback with Google; use a preview callback for preview.
# GROWTHOS_GOOGLE_CLIENT_ID=
# GROWTHOS_GOOGLE_CLIENT_SECRET=
# GROWTHOS_GMAIL_REDIRECT_URI=https://your-preview-domain.example/admin/growth-os/gmail/callback
# Base64 encoding of 32 cryptographically random bytes; store securely, never commit.
# GROWTHOS_GMAIL_ENCRYPTION_KEY=
